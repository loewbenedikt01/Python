\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Full-period performance per model, sorted by Sharpe ratio.}}{7}{}\protected@file@percent }
\newlabel{tab:performance}{{1}{7}{}{table.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Crisis probability $p_{\mathrm  {crisis}}$ of the three regime detectors: changepoint detection (VIX, top), Hidden Markov Model (S\&P 500, middle) and Wasserstein clustering (S\&P 500 and VIX, bottom). Dashed: 0.5 threshold; grey shading: crisis periods; red lines: peak, trough and recovery.}}{8}{}\protected@file@percent }
\newlabel{fig:pcrisis_sp}{{4}{8}{}{figure.4}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Crisis profile of the baseline models, monthly rebalancing, equal-weighted across seven crises (C1--C7). PTT (peak to trough), TTP (trough to recovery) and Full: average excess return over MCap, $(1+r)/(1+r_{\text  {MCap}}) - 1$. $\Delta $ Ulcer: difference in Ulcer index to MCap, in percentage points (crisis peak to next crisis peak). $\Delta $ Rec.: difference in trading days from the S\&P~500 peak until the portfolio regains its starting value (C2 excluded, as MCap did not recover before the GFC; weights rescaled over C1 and C3--C7). Negative $\Delta $ values indicate less pain / faster recovery than MCap, whereas for PTT, TTP and Full positive is better. Hits: crises in which the model's excess return in the phase was positive.}}{8}{}\protected@file@percent }
\newlabel{tab:crisis}{{2}{8}{}{table.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Return (Ret.) and maximum drawdown (MDD) per crisis, in \%, monthly rebalancing, from the S\&P~500 peak until the S\&P~500 is back at that peak: C1 1998 (Russia/LTCM), C2 dot-com, C3 GFC, C4 monetary policy shock 2018, C5 COVID-19, C6 inflation and rate hikes 2022, C7 trade policy shock 2025. GSPC: S\&P~500 price index, its return is about zero by construction of the windows.}}{9}{}\protected@file@percent }
\newlabel{tab:crisis_returns}{{3}{9}{}{table.3}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {7.1}Crisis Excess Returns: Peak to Trough vs.\ Trough to Recovery}{9}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Average crisis excess return over the benchmark per model: peak to trough ($x$) vs.\ trough to recovery ($y$). The dotted line marks $x + y = 0$: models above it gain over the whole crisis (peak to recovery), models below lose. The line is approximate, since the two phases compound, $(1+x)(1+y)-1 \ne  x+y$, rather than add.}}{10}{}\protected@file@percent }
\newlabel{fig:scatter_crisis_excess}{{5}{10}{}{figure.5}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {7.2}Detection Quality}{11}{}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Crisis detection quality of the regime detectors by evaluation frequency. Defensive: share of days in the crisis state; Episodes: number of crisis-state episodes; Avg.\ ep.: mean length of an episode in trading days; Recall: share of crisis days flagged; Precision: share of flagged days that are crisis days; Lift: precision relative to the share of crisis days in the sample; False alarms: flagged days outside crises; Missed: crises (of seven) never flagged.}}{11}{}\protected@file@percent }
\newlabel{tab:detection}{{4}{11}{}{table.4}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Timing of the regime detectors around the crises, by evaluation frequency. Exit lag: median trading days from the crisis peak until the detector switches to the crisis state (negative = before the peak); Re-entry lag: median trading days until it switches back; Missed: crises not flagged; Late def.: crises flagged only late; Not recovered: crises after which the detector did not leave the crisis state before the next crisis.}}{12}{}\protected@file@percent }
\newlabel{tab:timing}{{5}{12}{}{table.5}{}}
